# ===== CONFIGURACIÓN DE BASE DE DATOS =====

# MONGODB LOCAL (para desarrollo)
MONGO_URI=mongodb://localhost:27017/tu_database

# MONGODB ATLAS (nube - reemplaza con tus credenciales)
# MONGO_URI=mongodb+srv://tu_usuario:tu_contraseña@cluster0.xxxxx.mongodb.net/tu_database

# ===== CONFIGURACIÓN DEL SERVIDOR =====
PORT=3000

# ===== CONFIGURACIÓN DE SEGURIDAD (opcional) =====
# JWT_SECRET=tu_clave_secreta_muy_segura
# BCRYPT_ROUNDS=12

# ===== CONFIGURACIÓN DE CORS (opcional) =====
# CLIENT_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== INSTRUCCIONES =====
# 1. Copia este archivo como .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. Para MongoDB Atlas: ve a tu cluster > Connect > Connect your application
# 4. Asegúrate de agregar tu IP a la whitelist en MongoDB Atlas